{
  "hosting": {
    "public": "apps/web/out",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "cleanUrls": true,
    "trailingSlash": false,
    "rewrites": [
      {
        "source": "/s/**",
        "run": {
          "serviceId": "teacherai-api",
          "region": "us-east4"
        }
      },
      {
        "source": "/api/**",
        "run": {
          "serviceId": "teacherai-api",
          "region": "us-east4"
        }
      }
    ]
  }
}
