TEACHERAI_ENVIRONMENT=development
TEACHERAI_APP_NAME=TeacherAI API
TEACHERAI_VERSION=0.1.0
TEACHERAI_API_PREFIX=/api/v1
TEACHERAI_LOG_LEVEL=INFO
TEACHERAI_CORS_ALLOWED_ORIGINS=["http://localhost:3000"]
NEXT_PUBLIC_TEACHERAI_API_BASE_URL=http://localhost:8000/api/v1
TEACHERAI_MAX_UPLOAD_SIZE_BYTES=10485760
TEACHERAI_UPLOAD_TEMP_DIRECTORY=tmp/uploads
TEACHERAI_DEBUG=false
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4.1-mini
OPENAI_LESSON_MODEL=gpt-4.1-mini
OPENAI_INTERACTION_MODEL=gpt-4.1-mini
TEACHERAI_FIREBASE_ENABLED=false
TEACHERAI_FIREBASE_PROJECT_ID=
TEACHERAI_FIREBASE_SERVICE_ACCOUNT_JSON=
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
