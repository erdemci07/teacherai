TEACHERAI_ENVIRONMENT=development
TEACHERAI_APP_NAME=TeacherAI API
TEACHERAI_VERSION=0.1.0
TEACHERAI_API_PREFIX=/api/v1
TEACHERAI_LOG_LEVEL=INFO
TEACHERAI_CORS_ALLOWED_ORIGINS=["https://teacherai-07.web.app","https://math-ai-07.web.app","http://localhost:3000","http://127.0.0.1:3000"]
NEXT_PUBLIC_TEACHERAI_API_BASE_URL=http://localhost:8000/api/v1
PUBLIC_APP_URL=https://teacherai-07.web.app
PUBLIC_SHARE_URL_BASE=https://YOUR_CLOUD_RUN_URL
TEACHERAI_MAX_UPLOAD_SIZE_BYTES=10485760
TEACHERAI_UPLOAD_TEMP_DIRECTORY=tmp/uploads
TEACHERAI_DEBUG=false
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4.1-mini
OPENAI_LESSON_MODEL=gpt-5.6-terra
OPENAI_INTERACTION_MODEL=gpt-4.1-mini
# Runtime uses durable storage outside tests. This flag also permits an explicitly configured test emulator.
TEACHERAI_FIREBASE_ENABLED=false
# Optional if Firebase Auth web registration belongs to another project.
TEACHERAI_FIREBASE_AUTH_PROJECT_ID=
TEACHERAI_APP_CHECK_MODE=off
NEXT_PUBLIC_FIREBASE_APP_CHECK_SITE_KEY=
TEACHERAI_AI_ENABLED=true
TEACHERAI_AI_CONCURRENCY=4
TEACHERAI_AUTHENTICATED_DAILY_AI_LIMIT=50
TEACHERAI_OPERATION_LIMITS={"analyze":20,"generate":20,"interact":40,"preview":30,"answer":80,"feedback":20,"understood":80}
TEACHERAI_MAX_JSON_BYTES=750000
TEACHERAI_UPLOAD_TIMEOUT_SECONDS=60
TEACHERAI_MAX_OUTPUT_TOKENS=4096
TEACHERAI_DAILY_OUTPUT_TOKENS=100000
TEACHERAI_VISION_PROVIDER_TIMEOUT_SECONDS=45
TEACHERAI_LESSON_PROVIDER_TIMEOUT_SECONDS=60
TEACHERAI_INTERACTION_PROVIDER_TIMEOUT_SECONDS=60
TEACHERAI_PRICING_VERSION=
TEACHERAI_MODEL_PRICES={}
TEACHERAI_FIREBASE_PROJECT_ID=math-ai-07
TEACHERAI_FIREBASE_SERVICE_ACCOUNT_JSON=
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
FEEDBACK_EMAIL_NOTIFICATIONS=false
FEEDBACK_NOTIFICATION_EMAIL=farukerdemci07@gmail.com
FEEDBACK_EMAIL_SENDER=
RESEND_API_KEY=
