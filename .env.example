TEACHERAI_ENVIRONMENT=development
TEACHERAI_APP_NAME=TeacherAI API
TEACHERAI_VERSION=0.1.0
TEACHERAI_API_PREFIX=/api/v1
TEACHERAI_LOG_LEVEL=INFO
TEACHERAI_CORS_ALLOWED_ORIGINS=["https://teacherai-07.web.app","https://math-ai-07.web.app","http://localhost:3000","http://127.0.0.1:3000"]
NEXT_PUBLIC_TEACHERAI_API_BASE_URL=http://localhost:8000/api/v1
PUBLIC_APP_URL=https://teacherai-07.web.app
PUBLIC_SHARE_URL_BASE=https://YOUR_CLOUD_RUN_URL
TEACHERAI_MAX_UPLOAD_SIZE_BYTES=10485760
TEACHERAI_UPLOAD_TEMP_DIRECTORY=tmp/uploads
TEACHERAI_DEBUG=false
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4.1-mini
OPENAI_LESSON_MODEL=gpt-5.6-terra
OPENAI_INTERACTION_MODEL=gpt-4.1-mini
# Runtime uses durable storage outside tests. This flag also permits an explicitly configured test emulator.
TEACHERAI_FIREBASE_ENABLED=false
# Optional if Firebase Auth web registration belongs to another project.
TEACHERAI_FIREBASE_AUTH_PROJECT_ID=
TEACHERAI_APP_CHECK_MODE=off
NEXT_PUBLIC_FIREBASE_APP_CHECK_SITE_KEY=
TEACHERAI_AI_ENABLED=true
TEACHERAI_AI_CONCURRENCY=4
TEACHERAI_AUTHENTICATED_DAILY_AI_LIMIT=50
TEACHERAI_OPERATION_LIMITS={"analyze":20,"generate":20,"interact":40,"preview":30,"answer":80,"feedback":20,"understood":80}
TEACHERAI_MAX_JSON_BYTES=750000
TEACHERAI_UPLOAD_TIMEOUT_SECONDS=60
# İşlem başına sağlayıcıya giden max_output_tokens; rezervasyon aynı değerle yapılır.
# Anahtarlar yalnızca vision, interaction, lessons; her değer 128-32000. Ders modeli
# akıl yürütme tokenlarını da bu bütçeden harcadığı için lessons daha yüksektir.
# TEACHERAI_MAX_OUTPUT_TOKENS (kullanımdan kaldırıldı) tanımlıysa yalnızca eksik işlemlere uygulanır.
TEACHERAI_MAX_OUTPUT_TOKENS_BY_OPERATION={"vision":4096,"interaction":4096,"lessons":16384}
# Boş: sağlayıcı varsayılanı. Örnek {"lessons":"low"}. Yalnız reasoning destekleyen
# modellerde geçerlidir; gpt-4.1-mini için değer verilirse uygulama başlamaz.
TEACHERAI_REASONING_EFFORT_BY_OPERATION={}
# Kullanıcı başına günlük çıktı token rezervasyonu: 200000 >= 8 x 16384 tam ders,
# kalan pay görsel analiz ve etkileşimlere kalır.
# İşlem kotası kabul anında tüketilir ve sağlayıcı hatasında iade edilmez.
TEACHERAI_DAILY_OUTPUT_TOKENS=200000
# Küresel günlük AI bütçesi (UTC günü, tüm kullanıcılar). Tek ai_global_usage/{YYYY-MM-DD}
# belgesinde kullanıcı sayacıyla aynı Firestore işleminde ayrılır; eşzamanlı isteklerde aşılmaz.
# İşletmeci trafiğe göre ayarlar. 0 ilgili ücretli yolu kapatır (TEACHERAI_AI_ENABLED'dan bağımsız).
# - PAID_OPERATIONS: kabul edilen ücretli HTTP işlemi (analyze, generate, interact)
# - PROVIDER_CALLS: gerçek sağlayıcı çağrısı; matematik düzeltme ve bağlam tekrarı ayrı sayılır
# - OUTPUT_TOKENS: ayrılmış çıktı tokenları; çağrı bitince kullanılmayan kısım bir kez iade edilir
# Bu sınırlar kesin bir USD tavanı DEĞİLDİR: giriş ve görsel tokenları, model fiyat farkları ve
# sağlayıcı muhasebesi ayrıdır. Kesin harcama sınırı için OpenAI proje bütçesini kullanın (rapor, C).
# Firestore'a ulaşılamazsa ücretli istek 503 ile reddedilir ve sağlayıcı çağrılmaz.
TEACHERAI_GLOBAL_DAILY_PAID_OPERATIONS=2000
TEACHERAI_GLOBAL_DAILY_PROVIDER_CALLS=4000
TEACHERAI_GLOBAL_DAILY_OUTPUT_TOKENS=20000000
# Sayaç işlemi okuma zaman aşımı (sn) ve SDK deneme sayısı; tükenirse 503 döner.
TEACHERAI_USAGE_TIMEOUT_SECONDS=5
TEACHERAI_USAGE_TRANSACTION_ATTEMPTS=5
TEACHERAI_VISION_PROVIDER_TIMEOUT_SECONDS=45
# 60 sn tam 16384 tokenlık bir üretimi bitirmeye yetmeyebilir; değiştirmeden önce
# ai_usage günlüklerindeki süre ve çıktı dağılımını ölçün (TA-001B raporu, A paketi).
TEACHERAI_LESSON_PROVIDER_TIMEOUT_SECONDS=60
TEACHERAI_INTERACTION_PROVIDER_TIMEOUT_SECONDS=60
TEACHERAI_PRICING_VERSION=
TEACHERAI_MODEL_PRICES={}
TEACHERAI_FIREBASE_PROJECT_ID=math-ai-07
TEACHERAI_FIREBASE_SERVICE_ACCOUNT_JSON=
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
FEEDBACK_EMAIL_NOTIFICATIONS=false
FEEDBACK_NOTIFICATION_EMAIL=farukerdemci07@gmail.com
FEEDBACK_EMAIL_SENDER=
RESEND_API_KEY=
