{
 "schema_name": "teacherai.math_regression",
 "version": "1.2.0",
 "note_tr": "TA-008/TA-008B matematik geliştirme ve regresyon derlemi. Bütün vakalar özgün ve sentetiktir; bağımsız değerlendirme setinden (evals/) ayrıdır ve onunla örtüşmez. Beklenen sonuçlar matematiksel olarak elle doğrulanmış kesin değerlerdir; model doğruluğu ölçmez.",
 "cases": [
  {"id": "found_integer_count", "area": "foundations", "kind": "inequality_integers", "args": {"latex": "1 < x \\le 4"}, "expect": 3},
  {"id": "found_rational_domain", "area": "foundations", "kind": "solve", "args": {"latex": "x^2 = 2", "domain": "rational"}, "expect": {"kind": "empty"}},
  {"id": "found_integer_domain", "area": "foundations", "kind": "solve", "args": {"latex": "2x = 3", "domain": "integer"}, "expect": {"kind": "empty"}},
  {"id": "alg_divide_by_x", "area": "algebra", "kind": "transform", "args": {"previous": "x^2 = 3x", "current": "x = 3", "original": "x^2 = 3x"}, "expect": {"relation": "loses", "hazard": "division_by_expression_with_zero"}},
  {"id": "alg_squaring_extraneous", "area": "algebra", "kind": "solve", "args": {"latex": "\\sqrt{x+5} = x - 1"}, "expect": {"kind": "finite", "elements": ["4"]}},
  {"id": "alg_squaring_gains", "area": "algebra", "kind": "transform", "args": {"previous": "\\sqrt{x+5} = x - 1", "current": "x + 5 = (x - 1)^2", "original": "\\sqrt{x+5} = x - 1"}, "expect": {"relation": "gains"}},
  {"id": "alg_rational_cancellation", "area": "algebra", "kind": "solve", "args": {"latex": "\\frac{x^2 - 1}{x - 1} = 2"}, "expect": {"kind": "empty", "exclusions": ["1"]}},
  {"id": "alg_negative_multiplication", "area": "algebra", "kind": "transform", "args": {"previous": "-2x < 6", "current": "x < -3", "original": "-2x < 6"}, "expect": {"relation": "changed", "hazard": "inequality_not_reversed"}},
  {"id": "alg_negative_multiplication_ok", "area": "algebra", "kind": "transform", "args": {"previous": "-2x < 6", "current": "x > -3", "original": "-2x < 6"}, "expect": {"relation": "equivalent"}},
  {"id": "alg_absolute_value_cases", "area": "algebra", "kind": "solve", "args": {"latex": "|x - 2| = 3"}, "expect": {"kind": "finite", "elements": ["-1", "5"]}},
  {"id": "alg_disconnected_intervals", "area": "algebra", "kind": "inequality", "args": {"latex": "x^2 - 4 > 0"}, "expect": {"intervals": ["(−∞, -2)", "(2, +∞)"]}},
  {"id": "alg_rational_inequality", "area": "algebra", "kind": "inequality", "args": {"latex": "\\frac{x - 1}{x + 2} \\le 0"}, "expect": {"intervals": ["(-2, 1]"], "exclusions": ["-2"]}},
  {"id": "alg_infinite_solutions", "area": "algebra", "kind": "solve", "args": {"latex": "x + 1 = x + 1"}, "expect": {"kind": "all"}},
  {"id": "alg_no_solution", "area": "algebra", "kind": "solve", "args": {"latex": "2x + 1 = 2x"}, "expect": {"kind": "empty"}},
  {"id": "alg_complex_roots", "area": "algebra", "kind": "solve", "args": {"latex": "x^2 = -4", "domain": "complex"}, "expect": {"kind": "finite", "elements": ["-2*I", "2*I"]}},
  {"id": "alg_real_no_roots", "area": "algebra", "kind": "solve", "args": {"latex": "x^2 = -4"}, "expect": {"kind": "empty"}},
  {"id": "alg_solver_incomplete", "area": "algebra", "kind": "solve", "args": {"latex": "\\sin(x) = x - 1"}, "expect": {"status_not": "exact"}},
  {"id": "alg_quadratic_alternatives", "area": "algebra", "kind": "alternatives", "args": {"latex": "x^2 - 5x + 6 = 0"}, "expect": {"strategies": ["factoring", "completing_square", "quadratic_formula"], "all_verified": true}},
  {"id": "alg_quadratic_irrational_no_factoring", "area": "algebra", "kind": "alternatives", "args": {"latex": "x^2 - 2 = 0"}, "expect": {"strategies": ["completing_square", "quadratic_formula"], "all_verified": true}},
  {"id": "fn_undefined_point_graph", "area": "functions", "kind": "function_graph", "args": {"latex": "\\frac{1}{x - 1}"}, "expect": {"discontinuities": ["1"], "segments": 2}},
  {"id": "fn_inverse_not_injective", "area": "functions", "kind": "inverse", "args": {"latex": "x^2"}, "expect": {"reason": "not_injective_on_domain"}},
  {"id": "fn_inverse_linear", "area": "functions", "kind": "inverse", "args": {"latex": "2x + 3"}, "expect": {"reason": "injective", "inverse": "x/2 - 3/2"}},
  {"id": "fn_inverse_cubic", "area": "functions", "kind": "inverse", "args": {"latex": "x^3"}, "expect": {"reason": "injective"}},
  {"id": "fn_composition_domain", "area": "functions", "kind": "compose", "args": {"outer": "\\sqrt{x}", "inner": "x - 2"}, "expect": {"domain": "Interval(2, oo)"}},
  {"id": "fn_vertex", "area": "functions", "kind": "vertex", "args": {"latex": "x^2 - 4x + 1"}, "expect": ["2", "-3", "minimum"]},
  {"id": "trig_periodic_roots_degree", "area": "trigonometry", "kind": "trig_interval", "args": {"latex": "\\sin(x) = \\frac{1}{2}", "lower": 0, "upper": 360, "unit": "degree"}, "expect": ["30", "150"]},
  {"id": "trig_tan_equation_degree", "area": "trigonometry", "kind": "trig_interval", "args": {"latex": "\\tan(x) = 1", "lower": 0, "upper": 360, "unit": "degree"}, "expect": ["45", "225"]},
  {"id": "trig_standard_value", "area": "trigonometry", "kind": "trig_value", "args": {"function": "cos", "angle": 60, "unit": "degree"}, "expect": "1/2"},
  {"id": "trig_undefined_value", "area": "trigonometry", "kind": "trig_value", "args": {"function": "tan", "angle": 90, "unit": "degree"}, "expect": {"error": "undefined_at_angle"}},
  {"id": "trig_unit_required", "area": "trigonometry", "kind": "trig_value", "args": {"function": "sin", "angle": 30, "unit": "unknown"}, "expect": {"error": "angle_unit_unknown"}},
  {"id": "prob_exactly_one_red", "area": "probability", "kind": "draw", "args": {"items": {"K": 3, "M": 2}, "draws": 2, "replacement": false, "event": "exactly_one:K"}, "expect": "3/5"},
  {"id": "prob_conditional_not_independent", "area": "probability", "kind": "draw_conditional", "args": {"items": {"K": 3, "M": 2}, "draws": 2, "replacement": false}, "expect": {"conditional": "1/2", "independent": false}},
  {"id": "prob_with_replacement_independent", "area": "probability", "kind": "draw_conditional", "args": {"items": {"K": 3, "M": 2}, "draws": 2, "replacement": true}, "expect": {"conditional": "3/5", "independent": true}},
  {"id": "prob_permutation_combination", "area": "probability", "kind": "counting", "args": {"n": 5, "k": 2}, "expect": {"permutations": 20, "combinations": 10}},
  {"id": "prob_malformed_distribution", "area": "probability", "kind": "distribution", "args": {"values": ["1/2", "1/3"]}, "expect": "total_not_one"},
  {"id": "stat_describe", "area": "statistics", "kind": "describe", "args": {"values": [2, 3, 3, 8]}, "expect": {"mean": "4", "median": "3", "modes": ["3"], "range": "6"}},
  {"id": "calc_no_extremum", "area": "calculus", "kind": "critical", "args": {"latex": "x^3"}, "expect": [["0", "no_extremum"]]},
  {"id": "calc_local_minimum", "area": "calculus", "kind": "critical", "args": {"latex": "x^2 - 2x"}, "expect": [["1", "local_minimum"]]},
  {"id": "calc_two_sided_limit_missing", "area": "calculus", "kind": "limit", "args": {"latex": "\\frac{1}{x}", "point": 0}, "expect": {"value": null}},
  {"id": "calc_removable_limit", "area": "calculus", "kind": "limit", "args": {"latex": "\\frac{x^2 - 1}{x - 1}", "point": 1}, "expect": {"value": "2"}},
  {"id": "calc_signed_vs_area", "area": "calculus", "kind": "definite", "args": {"latex": "x", "lower": -1, "upper": 1}, "expect": {"signed": "0", "area": "1", "kind": "proper"}},
  {"id": "calc_improper", "area": "calculus", "kind": "definite", "args": {"latex": "\\frac{1}{x}", "lower": -1, "upper": 1}, "expect": {"kind": "improper"}},
  {"id": "calc_antiderivative", "area": "calculus", "kind": "antiderivative", "args": {"integrand": "2x", "candidate": "x^2 + 5"}, "expect": true},
  {"id": "calc_wrong_antiderivative", "area": "calculus", "kind": "antiderivative", "args": {"integrand": "2x", "candidate": "x^2 + x"}, "expect": false},
  {"id": "geo_pythagorean_marked", "area": "geometry", "kind": "geometry", "args": {"model": {"points": ["A", "B", "C"], "facts": [{"id": "t", "kind": "triangle", "points": ["A", "B", "C"], "origin": "stated", "evidence": "ABC üçgeninde"}, {"id": "ab", "kind": "segment_length", "points": ["A", "B"], "origin": "stated", "evidence": "AB = 3 cm", "value": "3"}, {"id": "bc", "kind": "segment_length", "points": ["B", "C"], "origin": "stated", "evidence": "BC = 4 cm", "value": "4"}, {"id": "r", "kind": "right_angle", "points": ["A", "B", "C"], "origin": "marked", "evidence": "B köşesinde dik açı işareti"}], "target": {"kind": "length", "points": ["A", "C"]}}, "text": "Şekildeki ABC üçgeninde AB = 3 cm ve BC = 4 cm'dir; B köşesindeki dik açı şekilde işaretlidir. AC kaç cm'dir?", "figure": true, "observations": ["B köşesinde dik açı işareti var"]}, "expect": {"determinacy": "determined", "values": ["5"]}, "note_tr": "TA-009: işaretli dik açı ilk görsel okumanın gözlemine bağlanır (diagram_observation)."},
  {"id": "geo_unmarked_perpendicular", "area": "geometry", "kind": "geometry", "args": {"model": {"points": ["A", "B", "C"], "facts": [{"id": "t", "kind": "triangle", "points": ["A", "B", "C"], "origin": "stated", "evidence": "ABC üçgeninde"}, {"id": "ab", "kind": "segment_length", "points": ["A", "B"], "origin": "stated", "evidence": "AB = 3 cm", "value": "3"}, {"id": "bc", "kind": "segment_length", "points": ["B", "C"], "origin": "stated", "evidence": "BC = 4 cm", "value": "4"}, {"id": "r", "kind": "right_angle", "points": ["A", "B", "C"], "origin": "visual_uncertain"}], "target": {"kind": "length", "points": ["A", "C"]}}, "text": "Şekildeki ABC üçgeninde AB = 3 cm ve BC = 4 cm'dir. AC kaç cm'dir?", "figure": true}, "expect": {"determinacy": "underdetermined", "reasons": ["visual_fact_not_given"]}},
  {"id": "geo_angle_sum", "area": "geometry", "kind": "geometry", "args": {"model": {"points": ["A", "B", "C"], "facts": [{"id": "t", "kind": "triangle", "points": ["A", "B", "C"], "origin": "stated", "evidence": "ABC üçgeninde"}, {"id": "a", "kind": "angle_measure", "points": ["C", "A", "B"], "origin": "stated", "evidence": "A açısı 50 derece", "value": "50"}, {"id": "b", "kind": "angle_measure", "points": ["A", "B", "C"], "origin": "stated", "evidence": "B açısı 60 derece", "value": "60"}], "target": {"kind": "angle", "points": ["B", "C", "A"]}}, "text": "ABC üçgeninde A açısı 50 derece, B açısı 60 derecedir. C açısı kaç derecedir?", "figure": false}, "expect": {"determinacy": "determined", "values": ["70"]}},
  {"id": "geo_impossible_triangle", "area": "geometry", "kind": "geometry", "args": {"model": {"points": ["A", "B", "C"], "facts": [{"id": "t", "kind": "triangle", "points": ["A", "B", "C"], "origin": "stated", "evidence": "ABC üçgeninde"}, {"id": "ab", "kind": "segment_length", "points": ["A", "B"], "origin": "stated", "evidence": "AB = 2", "value": "2"}, {"id": "bc", "kind": "segment_length", "points": ["B", "C"], "origin": "stated", "evidence": "BC = 3", "value": "3"}, {"id": "ac", "kind": "segment_length", "points": ["A", "C"], "origin": "stated", "evidence": "AC = 7", "value": "7"}]}, "text": "ABC üçgeninde AB = 2, BC = 3 ve AC = 7 veriliyor.", "figure": false}, "expect": {"determinacy": "inconsistent", "reasons": ["triangle_inequality_violated"]}},
  {"id": "geo_mismatched_similarity", "area": "geometry", "kind": "geometry", "args": {"model": {"points": ["A", "B", "C", "D", "E", "F"], "facts": [{"id": "s", "kind": "similar", "points": ["A", "B", "C"], "origin": "stated", "evidence": "ABC ~ DEF", "other": ["D", "E", "F"]}, {"id": "ab", "kind": "segment_length", "points": ["A", "B"], "origin": "stated", "evidence": "AB = 4", "value": "4"}, {"id": "bc", "kind": "segment_length", "points": ["B", "C"], "origin": "stated", "evidence": "BC = 6", "value": "6"}, {"id": "de", "kind": "segment_length", "points": ["D", "E"], "origin": "stated", "evidence": "DE = 3", "value": "3"}, {"id": "ef", "kind": "segment_length", "points": ["E", "F"], "origin": "stated", "evidence": "EF = 2", "value": "2"}]}, "text": "ABC ~ DEF olmak üzere AB = 4, BC = 6, DE = 3 ve EF = 2 veriliyor.", "figure": false}, "expect": {"reasons": ["correspondence_mismatch"]}},
  {"id": "geo_underdetermined", "area": "geometry", "kind": "geometry", "args": {"model": {"points": ["A", "B", "C"], "facts": [{"id": "t", "kind": "triangle", "points": ["A", "B", "C"], "origin": "stated", "evidence": "ABC üçgeninde"}, {"id": "ab", "kind": "segment_length", "points": ["A", "B"], "origin": "stated", "evidence": "AB = 5", "value": "5"}], "target": {"kind": "length", "points": ["B", "C"]}}, "text": "ABC üçgeninde AB = 5 ise BC kaçtır?", "figure": false}, "expect": {"determinacy": "underdetermined"}},
  {"id": "geo_coordinate_distance", "area": "geometry", "kind": "geometry", "args": {"model": {"points": ["A", "B"], "facts": [{"id": "a", "kind": "coordinate", "points": ["A"], "origin": "stated", "evidence": "A(1, 2)", "value": "(1, 2)"}, {"id": "b", "kind": "coordinate", "points": ["B"], "origin": "stated", "evidence": "B(4, 6)", "value": "(4, 6)"}], "target": {"kind": "length", "points": ["A", "B"]}}, "text": "A(1, 2) ve B(4, 6) noktaları arasındaki uzaklık kaç birimdir?", "figure": false}, "expect": {"determinacy": "determined", "values": ["5"]}},
  {"id": "geo_isosceles", "area": "geometry", "kind": "geometry", "args": {"model": {"points": ["A", "B", "C"], "facts": [{"id": "t", "kind": "triangle", "points": ["A", "B", "C"], "origin": "stated", "evidence": "ABC üçgeninde"}, {"id": "s", "kind": "equal_segments", "points": ["A", "B"], "origin": "stated", "evidence": "AB = AC", "other": ["A", "C"]}, {"id": "e", "kind": "equal_angles", "points": ["A", "B", "C"], "origin": "derived", "other": ["A", "C", "B"], "premises": ["t", "s"], "rule": "isosceles_base_angles"}, {"id": "a", "kind": "angle_measure", "points": ["B", "A", "C"], "origin": "stated", "evidence": "A açısı 40 derece", "value": "40"}], "target": {"kind": "angle", "points": ["A", "B", "C"]}}, "text": "ABC üçgeninde AB = AC ve A açısı 40 derecedir. B açısı kaç derecedir?", "figure": false}, "expect": {"determinacy": "determined", "values": ["70"]}},
  {"id": "geo_construction_overreach", "area": "geometry", "kind": "geometry", "args": {"model": {"points": ["A", "B", "C"], "facts": [{"id": "t", "kind": "triangle", "points": ["A", "B", "C"], "origin": "stated", "evidence": "ABC üçgeninde"}, {"id": "h1", "kind": "right_angle", "points": ["A", "H", "B"], "origin": "construction"}, {"id": "h2", "kind": "point_on_segment", "points": ["H", "B", "C"], "origin": "construction"}, {"id": "x", "kind": "equal_segments", "points": ["B", "H"], "origin": "construction", "other": ["H", "C"]}], "constructions": [{"id": "c1", "kind": "altitude", "references": ["A", "B", "C"], "new_points": ["H"], "establishes": ["h1", "h2"], "purpose_tr": "Dik üçgen elde etmek için yükseklik."}]}, "text": "ABC üçgeninde A köşesinden BC doğrusuna yükseklik çiziliyor.", "figure": false}, "expect": {"reasons": ["construction_overreach"]}, "note_tr": "TA-008B: yükseklik ayağının BC doğru parçası üzerinde olduğu tanımdan izlemez (geniş açılı üçgende uzantıdadır)."},
  {"id": "word_age_determined", "area": "word_problems", "kind": "word", "args": {"model": {"problem_type": "age", "quantities": [{"symbol": "a", "name_tr": "Ali'nin yaşı"}, {"symbol": "b", "name_tr": "Babanın yaşı"}, {"symbol": "s", "name_tr": "Toplam", "value": "48"}], "relations": ["a + b = s", "b = 3a"], "constraints": [{"symbol": "a", "kind": "natural"}], "objective": "a"}, "text": "Ali ile babasının yaşları toplamı 48'dir ve baba Ali'nin 3 katı yaşındadır."}, "expect": {"status": "determined", "values": ["12"], "fidelity": "partially_checked"}},
  {"id": "word_value_not_in_source", "area": "word_problems", "kind": "word", "args": {"model": {"problem_type": "age", "quantities": [{"symbol": "a", "name_tr": "a"}, {"symbol": "b", "name_tr": "b"}, {"symbol": "s", "name_tr": "Toplam", "value": "48"}], "relations": ["a + b = s", "b = 3a"], "objective": "a"}, "text": "Yaşları toplamı 50'dir."}, "expect": {"fidelity": "failed"}},
  {"id": "word_insufficient", "area": "word_problems", "kind": "word", "args": {"model": {"problem_type": "linear_system", "quantities": [{"symbol": "x", "name_tr": "x"}, {"symbol": "y", "name_tr": "y"}], "relations": ["x + y = 10"], "objective": "x"}, "text": "İki sayının toplamı 10'dur."}, "expect": {"status": "insufficient"}},
  {"id": "word_inconsistent", "area": "word_problems", "kind": "word", "args": {"model": {"problem_type": "linear_system", "quantities": [{"symbol": "x", "name_tr": "x"}, {"symbol": "y", "name_tr": "y"}], "relations": ["x + y = 10", "x + y = 12"], "objective": "x"}, "text": "Toplam 10 ve 12."}, "expect": {"status": "inconsistent"}},
  {"id": "word_discrete_violation", "area": "word_problems", "kind": "word", "args": {"model": {"problem_type": "ratio", "quantities": [{"symbol": "n", "name_tr": "Öğrenci sayısı", "discrete": true}], "relations": ["2n = 7"], "objective": "n"}, "text": "İki katı 7 olan öğrenci sayısı."}, "expect": {"status": "inconsistent"}},
  {"id": "word_work_rate", "area": "word_problems", "kind": "word", "args": {"model": {"problem_type": "work_rate", "quantities": [{"symbol": "t", "name_tr": "Birlikte süre"}, {"symbol": "a", "name_tr": "Ali'nin süresi", "value": "6"}, {"symbol": "b", "name_tr": "Ayşe'nin süresi", "value": "3"}], "relations": ["\\frac{1}{t} = \\frac{1}{a} + \\frac{1}{b}"], "constraints": [{"symbol": "t", "kind": "positive"}], "objective": "t"}, "text": "Ali bir işi 6 saatte, Ayşe 3 saatte bitiriyor."}, "expect": {"status": "determined", "values": ["2"]}},
  {"id": "strategy_formula_outside_grade", "area": "strategy", "kind": "strategy", "args": {"features": ["quadratic"], "grade": 8, "forbidden": []}, "expect": {"quadratic_formula": false, "completing_square": false}},
  {"id": "strategy_formula_forbidden", "area": "strategy", "kind": "strategy", "args": {"features": ["quadratic"], "grade": 10, "forbidden": ["quadratic_formula"]}, "expect": {"quadratic_formula": "forbidden_by_approved_policy"}},
  {"id": "geo_no_source_provider_label", "area": "geometry", "kind": "geometry", "args": {"model": {"points": ["A", "B", "C"], "facts": [{"id": "t", "kind": "triangle", "points": ["A", "B", "C"], "origin": "stated"}, {"id": "r", "kind": "right_angle", "points": ["A", "B", "C"], "origin": "stated"}, {"id": "ab", "kind": "segment_length", "points": ["A", "B"], "origin": "stated", "value": "3"}, {"id": "bc", "kind": "segment_length", "points": ["B", "C"], "origin": "stated", "value": "4"}], "target": {"kind": "length", "points": ["A", "C"]}}, "text": "", "figure": false}, "expect": {"determinacy": "underdetermined", "reasons": ["provider_proposed"]}, "note_tr": "Sağlayıcının 'stated' etiketi tek başına olgu kurmaz."},
  {"id": "geo_fabricated_evidence", "area": "geometry", "kind": "geometry", "args": {"model": {"points": ["A", "B", "C"], "facts": [{"id": "t", "kind": "triangle", "points": ["A", "B", "C"], "origin": "stated", "evidence": "ABC üçgeninde"}, {"id": "ab", "kind": "segment_length", "points": ["A", "B"], "origin": "stated", "evidence": "AB = 3 cm", "value": "3"}, {"id": "bc", "kind": "segment_length", "points": ["B", "C"], "origin": "stated", "evidence": "BC = 4 cm", "value": "4"}, {"id": "r", "kind": "right_angle", "points": ["A", "B", "C"], "origin": "stated", "evidence": "ABC dik üçgendir"}], "target": {"kind": "length", "points": ["A", "C"]}}, "text": "ABC üçgeninde AB = 3 cm ve BC = 4 cm'dir. AC kaç cm'dir?", "figure": false}, "expect": {"determinacy": "underdetermined", "reasons": ["provider_proposed"]}},
