    {"id": "sci.mass-weight", "version": 1, "subject": "science", "topic": "kuvvet_ve_enerji", "kind": "relationship",
     "title_tr": "Ortaokulda kütle ve ağırlık",
     "statement_tr": "Ağırlık kütleye etki eden yer çekimi kuvvetidir ve dinamometreyle ölçülür; kütle eşit kollu terazi gibi araçlarla ölçülür ve gök cismine göre değişmez.",
     "simplifications": [{"level": "7. sınıf", "text_tr": "Ağırlık bir kuvvettir, birimi newtondur; kütlenin birimi kilogramdır.", "omits_tr": "W = mg ifadesindeki g'nin konuma bağlı değişimi ve eylemsizlik tanımı."}],
     "misconceptions_tr": ["Günlük dilde 'kilom' derken ağırlığın kastedildiğini fark etmemek."],
     "outcome_refs": ["meb-2018.fen-bilimleri.3-8::F.7.3.1.1", "meb-2018.fen-bilimleri.3-8::F.7.3.1.2"],
     "related": ["phys.mass-weight"],
     "provenance": [{"source_id": "openstax.university-physics-volume-1", "section": "5.4 Mass and Weight", "url": "https://openstax.org/books/university-physics-volume-1/pages/5-4-mass-and-weight", "verified_on": "2026-11-24"}],
     "authored_by": "claude-draft", "status": "draft"},
    {"id": "sci.density", "version": 1, "subject": "science", "topic": "madde_ve_isi", "kind": "relationship",
     "title_tr": "Ortaokulda yoğunluk",
     "statement_tr": "Yoğunluk bir maddenin birim hacminin kütlesidir ve maddeyi ayırt etmeye yarar; birbiri içinde çözünmeyen sıvılarda yoğunluğu küçük olan üste çıkar.",
     "simplifications": [{"level": "6. sınıf", "text_tr": "Yoğunluk = kütle / hacim, birimi g/cm³.", "omits_tr": "Sıcaklık ve basıncın yoğunluğa etkisi."}],
     "outcome_refs": ["meb-2018.fen-bilimleri.3-8::F.6.4.2.1", "meb-2018.fen-bilimleri.3-8::F.6.4.2.2"],
     "related": ["phys.density"],
     "verifiers": [{"verifier": "reasoning.formula.evaluate", "checks_tr": "Kütle/hacim hesabı."}],
     "provenance": [{"source_id": "openstax.university-physics-volume-1", "section": "14.1 Fluids, Density, and Pressure", "url": "https://openstax.org/books/university-physics-volume-1/pages/14-1-fluids-density-and-pressure", "verified_on": "2026-11-24"}],
     "authored_by": "claude-draft", "status": "draft"},
    {"id": "sci.solid-pressure", "version": 1, "subject": "science", "topic": "basinc", "kind": "relationship",
     "title_tr": "Katı basıncı",
     "statement_tr": "Katı basıncı yüzeye dik etki eden kuvvetle doğru, yüzey alanıyla ters orantılıdır; aynı ağırlıktaki cisim daha küçük yüzeye daha büyük basınç uygular.",
     "simplifications": [{"level": "8. sınıf", "text_tr": "Basınç = kuvvet / yüzey alanı.", "omits_tr": "Kuvvetin yüzeye dik olmayan bileşenleri."}],
     "outcome_refs": ["meb-2018.fen-bilimleri.3-8::F.8.3.1.1"],
     "related": ["phys.pressure"],
     "provenance": [{"source_id": "openstax.university-physics-volume-1", "section": "14.1 Fluids, Density, and Pressure", "url": "https://openstax.org/books/university-physics-volume-1/pages/14-1-fluids-density-and-pressure", "verified_on": "2026-11-24"}],
     "authored_by": "claude-draft", "status": "draft"},
    {"id": "sci.chemical-reaction", "version": 1, "subject": "science", "topic": "madde_ve_endustri", "kind": "relationship",
     "title_tr": "Kimyasal tepkime ve kütlenin korunumu",
     "statement_tr": "Kimyasal tepkimede atomlar yeniden düzenlenerek yeni maddeler oluşur; kapalı kapta tepkimeden önceki ve sonraki toplam kütle aynıdır.",
     "simplifications": [{"level": "8. sınıf", "text_tr": "Tepkimede atomlar kaybolmaz, yer değiştirir.", "omits_tr": "Denklem denkleştirme ve mol hesabı."}],
     "outcome_refs": ["meb-2018.fen-bilimleri.3-8::F.8.4.3.1"],
     "related": ["chem.mass-conservation"],
     "provenance": [{"source_id": "openstax.chemistry-2e", "section": "2.1 Early Ideas in Atomic Theory", "url": "https://openstax.org/books/chemistry-2e/pages/2-1-early-ideas-in-atomic-theory", "verified_on": "2026-11-24"}],
     "authored_by": "claude-draft", "status": "draft"},
    {"id": "sci.dna-gene-chromosome", "version": 1, "subject": "science", "topic": "dna_ve_genetik_kod", "kind": "relationship",
     "title_tr": "Nükleotit, gen, DNA ve kromozom",
     "statement_tr": "DNA nükleotitlerden oluşur; gen, bir özelliğe ait bilgiyi taşıyan DNA bölümüdür; kromozom ise DNA'nın proteinlerle paketlenmiş yapısıdır.",
     "simplifications": [{"level": "8. sınıf", "text_tr": "Nükleotit < gen < DNA < kromozom sıralaması.", "omits_tr": "Genlerin protein şifreleyen ve şifrelemeyen bölgeleri."}],
     "outcome_refs": ["meb-2018.fen-bilimleri.3-8::F.8.2.1.1"],
     "related": ["bio.dna-structure"],
     "visuals": ["labeled_structure"],
     "provenance": [{"source_id": "openstax.biology-2e", "section": "14.2 DNA Structure and Sequencing", "url": "https://openstax.org/books/biology-2e/pages/14-2-dna-structure-and-sequencing", "verified_on": "2026-11-24"}],
     "authored_by": "claude-draft", "status": "draft"},
    {"id": "sci.food-chain", "version": 1, "subject": "science", "topic": "enerji_donusumleri", "kind": "relationship",
     "title_tr": "Besin zinciri",
     "statement_tr": "Besin zincirinde üreticiler güneş enerjisini besine dönüştürür, tüketiciler besinleri tüketir, ayrıştırıcılar ölü organik maddeyi parçalayarak maddeyi doğaya geri kazandırır.",
     "simplifications": [{"level": "8. sınıf", "text_tr": "Üretici → tüketici → ayrıştırıcı.", "omits_tr": "Besin ağı karmaşıklığı ve basamaklar arası enerji verimi."}],
     "outcome_refs": ["meb-2018.fen-bilimleri.3-8::F.8.6.1.1"],
     "related": ["bio.ecosystem-energy-flow"],
     "provenance": [{"source_id": "openstax.biology-2e", "section": "46.2 Energy Flow through Ecosystems", "url": "https://openstax.org/books/biology-2e/pages/46-2-energy-flow-through-ecosystems", "verified_on": "2026-11-24"}],
