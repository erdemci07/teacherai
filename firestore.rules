rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owns(uid) { return request.auth != null && request.auth.uid == uid; }
    match /users/{uid} { allow read: if owns(uid); allow write: if false; }
    match /student_profiles/{uid} { allow read: if owns(uid); allow write: if false; }
    match /student_memories/{uid} { allow read: if owns(uid); allow write: if false; }
    match /lessons/{id} { allow read: if request.auth != null && resource.data.student_id == request.auth.uid; allow write: if false; }
    match /interaction_events/{id} { allow read: if request.auth != null && resource.data.student_id == request.auth.uid; allow write: if false; }
    match /practice_attempts/{id} { allow read: if request.auth != null && resource.data.student_id == request.auth.uid; allow write: if false; }
  }
}
