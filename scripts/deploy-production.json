{
  "project_id": "teacherai-07",
  "service": "teacherai-api",
  "repository": "teacherai",
  "runtime_service_account": "teacherai-api-runtime",
  "region": null,
  "region_decision": "K2 bekliyor (docs/migration/TA-005-runbook.md §0). Öneri: Firestore eur3 + Cloud Run europe-west1. Karar verilince bu alan ve firebase.json run.region birlikte güncellenir.",
  "max_instances": 20,
  "min_instances": 0,
  "concurrency": 80,
  "timeout_seconds": 300,
  "cpu": "1",
  "memory": "512Mi",
  "secret": {"env": "OPENAI_API_KEY", "name": "openai-api-key", "version": "latest"},
  "required_apis": [
    "run.googleapis.com",
    "artifactregistry.googleapis.com",
    "cloudbuild.googleapis.com",
    "secretmanager.googleapis.com",
    "firestore.googleapis.com",
    "iam.googleapis.com"
  ],
  "runtime_env_policy": {
    "note": "TA-005C §10. Update modunda çalışan servisin ortamı okunur. Yönetilen değişkenler bu betikten gelir; preserve_env listesindeki onaylı çalışma zamanı ayarları ve preserve_secrets listesindeki secret referansları korunur; prohibited_env veya listede olmayan bir ad dağıtımı değişiklikten önce durdurur. Bir ayarı kaldırmak yalnız --drop-env AD ile açıkça yapılır.",
    "preserve_env": [
      "OPENAI_VISION_MODEL", "TEACHERAI_OPENAI_VISION_MODEL",
      "OPENAI_LESSON_MODEL", "TEACHERAI_OPENAI_LESSON_MODEL",
      "OPENAI_INTERACTION_MODEL", "TEACHERAI_OPENAI_INTERACTION_MODEL",
      "TEACHERAI_PROVIDER_VISION", "TEACHERAI_PROVIDER_LESSON", "TEACHERAI_PROVIDER_INTERACTION",
      "TEACHERAI_ANTHROPIC_VISION_MODEL", "TEACHERAI_ANTHROPIC_LESSON_MODEL", "TEACHERAI_ANTHROPIC_INTERACTION_MODEL",
      "TEACHERAI_ALLOW_STUDENT_IMAGES_TO_ANTHROPIC",
      "TEACHERAI_REASONING_EFFORT_BY_OPERATION", "TEACHERAI_MAX_OUTPUT_TOKENS_BY_OPERATION",
      "TEACHERAI_MODEL_PRICES", "TEACHERAI_PRICING_VERSION",
      "TEACHERAI_MAINTENANCE_MODE", "TEACHERAI_LEGACY_REDIRECT_BASE",
      "TEACHERAI_AI_ENABLED", "TEACHERAI_AI_CONCURRENCY",
      "TEACHERAI_AUTHENTICATED_DAILY_AI_LIMIT", "TEACHERAI_OPERATION_LIMITS", "TEACHERAI_DAILY_OUTPUT_TOKENS",
      "TEACHERAI_GLOBAL_DAILY_PAID_OPERATIONS", "TEACHERAI_GLOBAL_DAILY_PROVIDER_CALLS", "TEACHERAI_GLOBAL_DAILY_OUTPUT_TOKENS",
      "TEACHERAI_VISION_MAX_RECHECKS", "TEACHERAI_LESSON_MAX_PROVIDER_CALLS", "TEACHERAI_INTERACTION_MAX_PROVIDER_CALLS",
      "TEACHERAI_APP_CHECK_MODE",
      "FEEDBACK_EMAIL_NOTIFICATIONS", "TEACHERAI_FEEDBACK_EMAIL_NOTIFICATIONS",
      "FEEDBACK_NOTIFICATION_EMAIL", "TEACHERAI_FEEDBACK_NOTIFICATION_EMAIL",
      "FEEDBACK_EMAIL_SENDER", "TEACHERAI_FEEDBACK_EMAIL_SENDER",
      "TEACHERAI_MATHAI_MAX_PROCESSES", "TEACHERAI_MATHAI_MAX_WAITING",
      "TEACHERAI_CORS_ALLOWED_ORIGINS", "PUBLIC_APP_URL", "TEACHERAI_PUBLIC_APP_URL",
      "PUBLIC_SHARE_URL_BASE", "TEACHERAI_PUBLIC_SHARE_URL_BASE",
      "TEACHERAI_VISION_PROVIDER_TIMEOUT_SECONDS", "TEACHERAI_LESSON_PROVIDER_TIMEOUT_SECONDS",
      "TEACHERAI_INTERACTION_PROVIDER_TIMEOUT_SECONDS", "LESSON_CONTEXT_MAX_BYTES", "TEACHERAI_LESSON_CONTEXT_MAX_BYTES",
      "TEACHERAI_LOG_LEVEL"
    ],
    "preserve_secrets": ["ANTHROPIC_API_KEY", "RESEND_API_KEY"],
    "prohibited_env": [
      "OPENAI_API_KEY", "TEACHERAI_OPENAI_API_KEY", "ANTHROPIC_API_KEY", "TEACHERAI_ANTHROPIC_API_KEY",
      "RESEND_API_KEY", "TEACHERAI_RESEND_API_KEY", "TEACHERAI_FIREBASE_SERVICE_ACCOUNT_JSON", "TEACHERAI_DEBUG"
    ]
  },
  "firebase_web": {
    "note": "TA-005C §9. AUTH_DOMAIN varsayılan olarak <proje>.firebaseapp.com veya <proje>.web.app olmalı. Özel alan adı yalnız buraya açıkça eklenince kabul edilir.",
    "approved_auth_domains": []
  }
}
